{
  "name": "mdm-supplements",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "env": {
    "local": {
      "name": "mdm-supplements-local",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mdm-store-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdm-store",
      "database_id": "1ba0b37f-dfb9-48d4-a62f-38df9c03d561",
      "migrations_dir": "migrations"
    }
  ]
}
